	<queryString>
		<![CDATA[SELECT 
    h.ranking,
    p.kode_pelatih,
    p.nama_pelatih,
    h.nilai_akhir,
    (h.nilai_akhir * 100) AS persentase
FROM hasil h
JOIN pelatih p ON h.id_pelatih = p.id_pelatih
ORDER BY h.ranking ASC]]>
	</queryString>
	<field name="ranking" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
